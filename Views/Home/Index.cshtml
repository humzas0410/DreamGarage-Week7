@using DreamGarage.Data;
@inject DreamGarage.Data.CarContext _context // need this to access the database context in the view //

@{
    ViewData["Title"] = "Home";
    var featured = _context.Cars.OrderByDescending(c => c.Horsepower).First();
}
<header>
<div class="text-center">
    <h1 class="display-2">DreamGarage</h1>
    <p class="lead">A place to create the garage of your dreams!</p>
</div>
</header>

<h2 class="h5 mt-4 text-center">Featured Dream Car:</h2>
<div class="row row-cols-1 row-cols-md-3 g-4 justify-content-center">
    <div class="col">
        @await Html.PartialAsync("_CarCard", featured)
    </div>
</div>
@section Scripts {
    <script src="https://jgrissom.github.io/dotnet-web-dev/week-07/homework-checks.js"></script>
}